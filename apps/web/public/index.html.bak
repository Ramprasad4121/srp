<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Security Reasoning Protocol — methodology-driven audit workbench for smart contract security">
  <title>SRP — Security Reasoning Protocol</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    /* ── Design tokens ─────────────────────────────────────────────── */
    :root {
      --c-bg:          #08090a;
      --c-surface:     #111318;
      --c-surface-2:   #1a1d23;
      --c-border:      #262a33;
      --c-border-strong: #363b47;
      --c-text:        #e4e6eb;
      --c-text-dim:    #9499ab;
      --c-text-muted:  #5c6079;
      
      /* Forensic Accents */
      --c-accent:      #00f5a0; /* Security Green */
      --c-accent-dim:  #004d32;
      --c-info:        #3b82f6; /* Evidence Blue */
      --c-warn:        #fbbf24; /* Caution Amber */
      --c-danger:      #ff4d4d; /* Risk Red */
      --c-provider:    #a78bfa;

      --font-sans:     'Inter', system-ui, -apple-system, sans-serif;
      --font-mono:     'JetBrains Mono', 'Fira Code', monospace;

      --radius:        4px; /* Sharper industrial corners */
      --radius-lg:     8px;
      --shadow:        0 4px 12px rgba(0,0,0,0.5);
      --transition:    150ms cubic-bezier(0.4, 0, 0.2, 1);
      
      --glow:          0 0 12px rgba(0, 245, 160, 0.3);
    }

    /* ── Reset ──────────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 15px; background: var(--c-bg); }
    body {
      font-family: var(--font-sans);
      background: var(--c-bg);
      color: var(--c-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      letter-spacing: -0.01em;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: var(--c-bg); }
    ::-webkit-scrollbar-thumb { background: var(--c-border-strong); border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--c-text-muted); }

    /* ── App shell ──────────────────────────────────────────────────── */
    #app {
      flex: 1;
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    .app-ready-layout {
      display: flex;
      flex: 1;
      height: 100vh;
      overflow: hidden;
    }

    /* ── Loading state ──────────────────────────────────────────────── */
    .loading-container {
      text-align: center;
    }
    .loading-spinner {
      width: 40px; height: 40px;
      border: 3px solid var(--c-border);
      border-top-color: var(--c-accent);
      border-radius: 50%;
      animation: spin .8s linear infinite;
      margin: 0 auto 1rem;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .loading-text {
      color: var(--c-text-dim);
      font-size: .875rem;
      letter-spacing: .03em;
    }

    /* ── Error state ────────────────────────────────────────────────── */
    .error-container {
      background: var(--c-surface);
      border: 1px solid var(--c-danger);
      border-radius: var(--radius-lg);
      padding: 2rem;
      max-width: 480px;
      text-align: center;
    }
    .error-icon { font-size: 2rem; margin-bottom: .75rem; }
    .error-title { font-weight: 600; margin-bottom: .5rem; color: var(--c-danger); }
    .error-detail { font-size: .875rem; color: var(--c-text-dim); font-family: var(--font-mono); }

    /* ── Onboarding ─────────────────────────────────────────────────── */
    .onboarding-shell {
      width: 100%;
      max-width: 600px;
    }

    .onboarding-header {
      text-align: center;
      margin-bottom: 2rem;
    }
    .onboarding-brand {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--c-accent);
      letter-spacing: .06em;
      text-transform: uppercase;
      margin-bottom: .25rem;
    }
    .onboarding-subtitle {
      font-size: .875rem;
      color: var(--c-text-dim);
    }

    /* Progress bar */
    .progress-bar-track {
      width: 100%;
      height: 4px;
      background: var(--c-border);
      border-radius: 2px;
      margin-bottom: 2rem;
      overflow: hidden;
    }
    .progress-bar-fill {
      height: 100%;
      background: var(--c-accent);
      border-radius: 2px;
      transition: width var(--transition);
    }

    .step-indicator {
      font-size: .75rem;
      color: var(--c-text-muted);
      text-align: center;
      margin-bottom: 1.5rem;
      font-family: var(--font-mono);
    }

    /* Cards */
    .setup-card {
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-lg);
      padding: 2rem;
      box-shadow: var(--shadow);
    }
    .setup-card h2 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: .5rem;
    }
    .setup-card p {
      color: var(--c-text-dim);
      font-size: .875rem;
      margin-bottom: 1.5rem;
      line-height: 1.6;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      padding: .65rem 1.5rem;
      font-size: .875rem;
      font-weight: 600;
      font-family: var(--font-sans);
      border: 1px solid transparent;
      border-radius: var(--radius);
      cursor: pointer;
      transition: background var(--transition), border-color var(--transition), transform 100ms;
    }
    .btn:active { transform: scale(.97); }
    .btn-primary {
      background: var(--c-accent);
      color: var(--c-bg);
    }
    .btn-primary:hover { background: #5eeb93; }
    .btn-secondary {
      background: var(--c-surface-2);
      color: var(--c-text);
      border-color: var(--c-border);
    }
    .btn-secondary:hover { border-color: var(--c-text-dim); }
    .btn-block { width: 100%; }

    /* Role selector */
    .role-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: .75rem;
      margin-bottom: 1.5rem;
    }
    .role-option {
      background: var(--c-surface-2);
      border: 2px solid var(--c-border);
      border-radius: var(--radius);
      padding: 1rem .75rem;
      text-align: center;
      cursor: pointer;
      transition: border-color var(--transition), background var(--transition);
    }
    .role-option:hover { border-color: var(--c-text-dim); }
    .role-option.selected {
      border-color: var(--c-accent);
      background: var(--c-accent-dim);
    }
    .role-option .role-icon { font-size: 1.5rem; margin-bottom: .5rem; }
    .role-option .role-label { font-weight: 600; font-size: .875rem; }
    .role-option .role-desc {
      font-size: .75rem;
      color: var(--c-text-dim);
      margin-top: .25rem;
    }

    /* Provider list */
    .provider-list {
      display: flex;
      flex-direction: column;
      gap: .5rem;
      margin-bottom: 1.5rem;
    }
    .provider-item {
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: .75rem 1rem;
      background: var(--c-surface-2);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      cursor: pointer;
      transition: border-color var(--transition);
    }
    .provider-item:hover { border-color: var(--c-text-dim); }
    .provider-item.selected { border-color: var(--c-accent); }
    .provider-check {
      width: 18px; height: 18px;
      border: 2px solid var(--c-border);
      border-radius: 4px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      font-size: .75rem;
      color: var(--c-accent);
      transition: border-color var(--transition), background var(--transition);
    }
    .provider-item.selected .provider-check {
      border-color: var(--c-accent);
      background: var(--c-accent-dim);
    }
    .provider-name { font-weight: 500; font-size: .875rem; }
    .provider-model {
      margin-left: auto;
      font-family: var(--font-mono);
      font-size: .75rem;
      color: var(--c-text-muted);
    }
    .provider-badge {
      font-size: .625rem;
      padding: .15rem .4rem;
      border-radius: 3px;
      background: var(--c-accent-dim);
      color: var(--c-accent);
      font-weight: 600;
      text-transform: uppercase;
    }

    /* Workspace form */
    .form-group {
      margin-bottom: 1rem;
    }
    .form-label {
      display: block;
      font-size: .75rem;
      font-weight: 600;
      color: var(--c-text-dim);
      margin-bottom: .35rem;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .form-input {
      width: 100%;
      padding: .6rem .75rem;
      font-size: .875rem;
      font-family: var(--font-mono);
      background: var(--c-surface-2);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      color: var(--c-text);
      transition: border-color var(--transition);
    }
    .form-input:focus {
      outline: none;
      border-color: var(--c-accent);
    }
    .form-select {
      width: 100%;
      padding: .6rem .75rem;
      font-size: .875rem;
      font-family: var(--font-sans);
      background: var(--c-surface-2);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      color: var(--c-text);
      cursor: pointer;
    }
    .form-select:focus { outline: none; border-color: var(--c-accent); }

    .checkbox-row {
      display: flex;
      align-items: center;
      gap: .5rem;
      margin-bottom: 1.5rem;
    }
    .checkbox-row input[type="checkbox"] {
      accent-color: var(--c-accent);
      width: 16px; height: 16px;
    }
    .checkbox-row label {
      font-size: .875rem;
      color: var(--c-text-dim);
    }

    /* ── Ready shell ────────────────────────────────────────────────── */
    .ready-shell {
      width: 100%;
      max-width: 960px;
    }
    .ready-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 0;
      border-bottom: 1px solid var(--c-border);
      margin-bottom: 2rem;
    }
    .ready-brand {
      font-size: 1rem;
      font-weight: 700;
      color: var(--c-accent);
      letter-spacing: .05em;
    }
    .ready-role {
      font-size: .75rem;
      font-family: var(--font-mono);
      color: var(--c-text-dim);
      padding: .25rem .5rem;
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
    }
    .ready-nav {
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
      margin-bottom: 2rem;
    }
    .nav-item {
      padding: .5rem 1rem;
      font-size: .8125rem;
      font-weight: 500;
      color: var(--c-text-dim);
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      cursor: pointer;
      transition: background var(--transition), color var(--transition), border-color var(--transition);
    }
    .nav-item:hover {
      color: var(--c-text);
      border-color: var(--c-text-dim);
    }
    .nav-item.active {
      color: var(--c-accent);
      border-color: var(--c-accent);
      background: var(--c-accent-dim);
    }
    .ready-content {
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-lg);
      padding: 2rem;
      min-height: 300px;
    }
    .ready-content h2 {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: .75rem;
    }
    .ready-content p {
      color: var(--c-text-dim);
      font-size: .875rem;
    }
    .health-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: .75rem;
      margin-top: 1.5rem;
    }
    .health-card {
      padding: 1rem;
      background: var(--c-surface-2);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
    }
    .health-label {
      font-size: .6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .04em;
      color: var(--c-text-muted);
      margin-bottom: .25rem;
    }
    .health-value {
      font-size: 1.375rem;
      font-weight: 700;
      font-family: var(--font-mono);
    }
    .health-value.ok { color: var(--c-accent); }
    .health-value.warn { color: var(--c-warn); }
    .health-value.error { color: var(--c-danger); }

    /* Run history list */
    .history-list {
      display: flex;
      flex-direction: column;
      gap: .75rem;
    }
    .history-item {
      padding: 1rem;
      background: var(--c-surface-2);
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      cursor: pointer;
      transition: border-color var(--transition);
    }
    .history-item:hover { border-color: var(--c-accent); }
    .history-meta {
      display: flex;
      justify-content: space-between;
      font-size: .75rem;
      color: var(--c-text-dim);
      margin-bottom: .5rem;
    }
    .history-id { font-family: var(--font-mono); color: var(--c-info); }
    .history-status { text-transform: uppercase; font-weight: 600; }
    .history-status.completed { color: var(--c-accent); }
    .history-status.running { color: var(--c-info); }
    .history-status.failed { color: var(--c-danger); }
  </style>
</head>
<body>
  <div id="app">
    <div class="loading-container">
      <div class="loading-spinner"></div>
      <div class="loading-text">Initializing SRP…</div>
    </div>
  </div>

  <script type="module">
    // ── Gateway API client ──────────────────────────────────────────
    const API_BASE = window.location.origin;

    async function apiRequest(path, options = {}) {
      try {
        const res = await fetch(`${API_BASE}${path}`, {
          ...options,
          headers: { "Content-Type": "application/json", ...options.headers }
        });
        const body = await res.json();
        if (!res.ok) return { ok: false, error: body.error || "request_failed", detail: body.detail };
        return { ok: true, data: body };
      } catch (err) {
        return { ok: false, error: "network_error", detail: err.message };
      }
    }

    const api = {
      getBootstrap:     () => apiRequest("/api/bootstrap"),
      getRuntime:       () => apiRequest("/api/runtime"),
      startRuntime:     () => apiRequest("/api/runtime/start", { method: "POST" }),
      getSetup:         () => apiRequest("/api/setup"),
      getRuns:          () => apiRequest("/api/runs"),
      getRun:           (id) => apiRequest(`/api/runs/${id}`),
      getRunEvents:     (id) => apiRequest(`/api/runs/${id}/events`),
      getArtifact:      (runId, artId) => apiRequest(`/api/runs/${runId}/artifacts/${artId}`),
      listSkills:       () => apiRequest("/api/skills"),
      getSkill:         (id) => apiRequest(`/api/skills/${id}`),
      listConversations:() => apiRequest("/api/chat/conversations"),
      createConversation:(body) => apiRequest("/api/chat/conversations", { method: "POST", body: JSON.stringify(body) }),
      getConversation:  (id) => apiRequest(`/api/chat/conversations/${id}`),
      addChatMessage:   (id, body) => apiRequest(`/api/chat/conversations/${id}/messages`, { method: "POST", body: JSON.stringify(body) }),
      setRole:          (role) => apiRequest("/api/setup/role", { method: "POST", body: JSON.stringify({ role }) }),
      setProviders:     (providers) => apiRequest("/api/setup/providers", { method: "POST", body: JSON.stringify({ providers }) }),
      setWorkspace:     (patch) => apiRequest("/api/setup/workspace", { method: "POST", body: JSON.stringify(patch) }),
      completeWelcome:  () => apiRequest("/api/setup/complete/welcome", { method: "POST", body: "{}" }),
      completeProviders:() => apiRequest("/api/setup/complete/providers", { method: "POST", body: "{}" }),
      completeWorkspace:() => apiRequest("/api/setup/complete/workspace", { method: "POST", body: "{}" }),
    };

    // ── SSE Event Client ──────────────────────────────────────────
    function initEventStream() {
      const eventSource = new EventSource(`${API_BASE}/api/events`);
      eventSource.onmessage = (e) => {
        try {
          const event = JSON.parse(e.data);
          if (event.type === "setup.updated" || event.type === "bootstrap.updated") {
            console.log(`[SSE] received ${event.type}, refreshing bootstrap...`);
            boot();
          } else if (
            event.type === "session.started" ||
            event.type === "phase.status.changed" ||
            event.type === "artifact.created"
          ) {
            console.log(`[SSE] runtime updated: ${event.type}`);
            if (activeTab === "audit-flow" || activeTab === "protocol-map") {
              fetchRuntimeStateAndRender();
            } else if (activeTab === "history") {
              const content = document.getElementById("ready-content");
              if (content) {
                renderHistoryTab(content);
              }
            } else if (activeTab === "chat") {
              const content = document.getElementById("ready-content");
              if (content) {
                renderChatTab(content);
              }
            }
          }
        } catch (err) {
          console.error("[SSE] parse error", err);
        }
      };
      eventSource.onerror = () => {
        console.warn("[SSE] dropped connection, will automatically reconnect...");
      };
      return eventSource;
    }

    initEventStream();

    // ── Provider catalog ────────────────
    const PROVIDERS = [
      { kind: "anthropic",         label: "Anthropic",        defaultModel: "claude-sonnet-4-0",                   supportsTools: true },
      { kind: "openai",            label: "OpenAI",           defaultModel: "gpt-4.1",                             supportsTools: true },
      { kind: "openai-compatible", label: "OpenAI Compatible",defaultModel: "gpt-4.1-mini",                        supportsTools: true },
      { kind: "nvidia",            label: "NVIDIA",           defaultModel: "meta/llama-3.1-70b-instruct",         supportsTools: false },
      { kind: "openrouter",        label: "OpenRouter",       defaultModel: "openai/gpt-4.1-mini",                 supportsTools: false },
      { kind: "ollama",            label: "Ollama (Local)",   defaultModel: "llama3.1:8b",                         supportsTools: false },
      { kind: "hugging-face",      label: "Hugging Face",     defaultModel: "meta-llama/Meta-Llama-3.1-70B-Instruct", supportsTools: false },
    ];

    // ── State ──────────────────────────────────────────────────────
    let appState = { kind: "loading" };
    let selectedRole = "hybrid";
    let selectedProviders = new Set();
    let activeTab = "overview";
    let runtimeState = null;
    let runHistory = [];
    let conversations = [];
    let activeConversationId = null;

    // ── Render engine ──────────────────────────────────────────────
    const $app = document.getElementById("app");

    function render() {
      switch (appState.kind) {
        case "loading":  return renderLoading();
        case "error":    return renderError();
        case "onboarding": return renderOnboarding();
        case "ready":    return renderReady();
      }
    }

    function renderLoading() {
      $app.innerHTML = `
        <div class="loading-container">
          <div class="loading-spinner"></div>
          <div class="loading-text">Initializing SRP…</div>
        </div>`;
    }

    function renderError() {
      $app.innerHTML = `
        <div class="error-container">
          <div class="error-icon">⚠</div>
          <div class="error-title">${appState.error}</div>
          ${appState.detail ? `<div class="error-detail">${appState.detail}</div>` : ""}
          <br>
          <button class="btn btn-secondary" onclick="boot()">Retry</button>
        </div>`;
    }

    // ── Onboarding renderer ────────────────────────────────────────
    function renderOnboarding() {
      const bs = appState.bootstrap;
      const screen = appState.screen || deriveScreen(bs);
      const progress = screenProgress(screen);
      const stepInfo = screenStepInfo(screen);

      $app.innerHTML = `
        <div class="onboarding-shell">
          <div class="onboarding-header">
            <div class="onboarding-brand">SRP</div>
            <div class="onboarding-subtitle">Security Reasoning Protocol</div>
          </div>
          <div class="progress-bar-track">
            <div class="progress-bar-fill" style="width: ${progress * 100}%"></div>
          </div>
          <div class="step-indicator">${stepInfo}</div>
          <div class="setup-card" id="onboarding-card"></div>
        </div>`;

      const card = document.getElementById("onboarding-card");
      switch (screen) {
        case "welcome":   return renderWelcomeCard(card);
        case "role":      return renderRoleCard(card);
        case "providers": return renderProvidersCard(card);
        case "workspace": return renderWorkspaceCard(card);
        case "complete":  return renderCompleteCard(card);
      }
    }

    function deriveScreen(bs) {
      if (bs.decision === "needs-providers") return "providers";
      const step = bs.onboarding.currentStep;
      if (step === "welcome") return "welcome";
      if (step === "role-selection") return "role";
      if (step === "providers") return "providers";
      if (step === "ready") return "complete";
      return "workspace";
    }

    const SCREENS = ["welcome", "role", "providers", "workspace", "complete"];
    function screenProgress(s) { return SCREENS.indexOf(s) / (SCREENS.length - 1); }
    function screenStepInfo(s) { return `STEP ${SCREENS.indexOf(s) + 1} OF ${SCREENS.length}`; }

    function renderWelcomeCard(el) {
      el.innerHTML = `
        <h2>Welcome to SRP</h2>
        <p>SRP is a methodology-driven security reasoning platform for smart contract auditors and developers.</p>
        <p>This setup will configure your workspace, provider connections, and role preferences.</p>
        <div id="setup-error" style="color:var(--c-danger); font-size:.75rem; margin-bottom:1rem; display:none"></div>
        <button class="btn btn-primary btn-block" id="btn-welcome">Get Started</button>`;
      document.getElementById("btn-welcome").addEventListener("click", async () => {
        const btn = document.getElementById("btn-welcome");
        const errorEl = document.getElementById("setup-error");
        btn.disabled = true;
        btn.innerText = "Processing...";
        errorEl.style.display = "none";

        const res = await api.completeWelcome();
        if (!res.ok) {
          errorEl.innerText = `Error: ${res.detail || res.error}`;
          errorEl.style.display = "block";
          btn.disabled = false;
          btn.innerText = "Get Started";
          return;
        }

        appState.screen = "role";
        render();
      });
    }

    function renderRoleCard(el) {
      el.innerHTML = `
        <h2>Choose Your Role</h2>
        <p>SRP adapts its interface, models, and skills to match how you work.</p>
        <div class="role-grid">
          <div class="role-option ${selectedRole === 'auditor' ? 'selected' : ''}" data-role="auditor">
            <div class="role-icon">🔍</div>
            <div class="role-label">Auditor</div>
            <div class="role-desc">Security analysis, findings, PoCs</div>
          </div>
          <div class="role-option ${selectedRole === 'developer' ? 'selected' : ''}" data-role="developer">
            <div class="role-icon">⚙</div>
            <div class="role-label">Developer</div>
            <div class="role-desc">NatSpec, tests, docs, reviews</div>
          </div>
          <div class="role-option ${selectedRole === 'hybrid' ? 'selected' : ''}" data-role="hybrid">
            <div class="role-icon">⚡</div>
            <div class="role-label">Both</div>
            <div class="role-desc">Full audit + dev workbench</div>
          </div>
        </div>
        <div id="setup-error" style="color:var(--c-danger); font-size:.75rem; margin-bottom:1rem; display:none"></div>
        <button class="btn btn-primary btn-block" id="btn-role">Continue</button>`;

      el.querySelectorAll(".role-option").forEach(opt => {
        opt.addEventListener("click", () => {
          selectedRole = opt.dataset.role;
          el.querySelectorAll(".role-option").forEach(o => o.classList.remove("selected"));
          opt.classList.add("selected");
        });
      });

      document.getElementById("btn-role").addEventListener("click", async () => {
        const btn = document.getElementById("btn-role");
        const errorEl = document.getElementById("setup-error");
        btn.disabled = true;
        btn.innerText = "Saving...";
        errorEl.style.display = "none";

        const res = await api.setRole(selectedRole);
        if (!res.ok) {
          errorEl.innerText = `Error: ${res.detail || res.error}`;
          errorEl.style.display = "block";
          btn.disabled = false;
          btn.innerText = "Continue";
          return;
        }

        appState.screen = "providers";
        render();
      });
    }

    async function renderProvidersCard(el) {
      const bs = appState.bootstrap;
      const providersHealth = bs.providers;

      // Initialize selectedProviders from manifest if empty
      if (selectedProviders.size === 0 && appState.manifest && appState.manifest.state.providers) {
        appState.manifest.state.providers.forEach(p => {
          if (p.enabled) selectedProviders.add(p.kind);
        });
      }

      el.innerHTML = `
        <h2>Models & Providers</h2>
        <p>Select the model providers you have access to. At least one <strong>healthy</strong> provider is required.</p>
        <div class="provider-list" id="provider-list">
          ${PROVIDERS.map(p => {
            const isSelected = selectedProviders.has(p.kind);
            const isFailing = providersHealth.failingKinds.includes(p.kind);
            const isHealthy = providersHealth.healthyKinds.includes(p.kind);
            
            let statusBadge = "";
            if (isSelected) {
              if (isHealthy) statusBadge = '<span class="provider-badge">healthy</span>';
              else if (isFailing) statusBadge = '<span class="provider-badge" style="background:var(--c-danger); color:white">key missing</span>';
            }

            return `
              <div class="provider-item ${isSelected ? 'selected' : ''}" data-kind="${p.kind}" style="${isFailing && isSelected ? 'border-color:var(--c-danger)' : ''}">
                <div class="provider-check">${isSelected ? '✓' : ''}</div>
                <div class="provider-name">${p.label}</div>
                ${statusBadge}
                <div class="provider-model">${p.defaultModel}</div>
              </div>`;
          }).join("")}
        </div>
        <div id="setup-error" style="color:var(--c-danger); font-size:.75rem; margin-bottom:1rem; display:none"></div>
        <div style="display:flex; gap:1rem">
          <button class="btn btn-secondary" style="flex:1" id="btn-providers-back">Back</button>
          <button class="btn btn-primary" style="flex:2" id="btn-providers" ${selectedProviders.size === 0 ? 'disabled' : ''}>
            Continue
          </button>
        </div>`;

      el.querySelectorAll(".provider-item").forEach(item => {
        item.addEventListener("click", () => {
          const kind = item.dataset.kind;
          if (selectedProviders.has(kind)) selectedProviders.delete(kind);
          else selectedProviders.add(kind);
          renderProvidersCard(el);
        });
      });

      document.getElementById("btn-providers-back").addEventListener("click", () => {
        appState.screen = "role";
        render();
      });

      document.getElementById("btn-providers").addEventListener("click", async () => {
        if (selectedProviders.size === 0) return;
        
        const btn = document.getElementById("btn-providers");
        const errorEl = document.getElementById("setup-error");
        btn.disabled = true;
        btn.innerText = "Saving...";
        errorEl.style.display = "none";

        const providers = [...selectedProviders].map(kind => {
          const p = PROVIDERS.find(x => x.kind === kind);
          return { kind, label: p.label, model: p.defaultModel, enabled: true };
        });

        const res1 = await api.setProviders(providers);
        if (!res1.ok) {
          errorEl.innerText = `Error: ${res1.detail || res1.error}`;
          errorEl.style.display = "block";
          btn.disabled = false;
          btn.innerText = "Continue";
          return;
        }

        const res2 = await api.completeProviders();
        if (!res2.ok) {
          errorEl.innerText = `Error: ${res2.detail || res2.error}`;
          errorEl.style.display = "block";
          btn.disabled = false;
          btn.innerText = "Continue";
          return;
        }

        appState.screen = "workspace";
        render();
      });
    }

    function renderWorkspaceCard(el) {
      el.innerHTML = `
        <h2>Workspace Setup</h2>
        <p>Configure where SRP stores outputs and how it connects to the internet.</p>
        <div class="form-group">
          <label class="form-label" for="outputDir">Output Directory</label>
          <input class="form-input" id="outputDir" type="text" value=".srp" placeholder=".srp">
        </div>
        <div class="form-group">
          <label class="form-label" for="internetMode">Internet Access</label>
          <select class="form-select" id="internetMode">
            <option value="local-only">Local only</option>
            <option value="local-plus-docs" selected>Local + trusted docs</option>
            <option value="local-plus-approved-web">Local + approved web</option>
            <option value="open-web">Open web</option>
          </select>
        </div>
        <div class="checkbox-row">
          <input type="checkbox" id="docker" checked>
          <label for="docker">Use Docker toolchains when available</label>
        </div>
        <div id="setup-error" style="color:var(--c-danger); font-size:.75rem; margin-bottom:1rem; display:none"></div>
        <button class="btn btn-primary btn-block" id="btn-workspace">Complete Setup</button>`;

      document.getElementById("btn-workspace").addEventListener("click", async () => {
        const btn = document.getElementById("btn-workspace");
        const errorEl = document.getElementById("setup-error");
        const outputDirectory = document.getElementById("outputDir").value || ".srp";
        const internetMode = document.getElementById("internetMode").value;
        const useDockerToolchains = document.getElementById("docker").checked;

        btn.disabled = true;
        btn.innerText = "Finalizing...";
        errorEl.style.display = "none";

        const res1 = await api.setWorkspace({ outputDirectory, internetMode, useDockerToolchains });
        if (!res1.ok) {
          errorEl.innerText = `Error: ${res1.detail || res1.error}`;
          errorEl.style.display = "block";
          btn.disabled = false;
          btn.innerText = "Complete Setup";
          return;
        }

        const res2 = await api.completeWorkspace();
        if (!res2.ok) {
          errorEl.innerText = `Error: ${res2.detail || res2.error}`;
          errorEl.style.display = "block";
          btn.disabled = false;
          btn.innerText = "Complete Setup";
          return;
        }

        appState.screen = "complete";
        render();
      });
    }

    function renderCompleteCard(el) {
      el.innerHTML = `
        <h2 style="text-align:center">✓ Setup Complete</h2>
        <p style="text-align:center">Your SRP workspace is configured and ready. The platform will now load your workbench.</p>
        <button class="btn btn-primary btn-block" id="btn-launch">Proceed to Workbench</button>`;

      document.getElementById("btn-launch").addEventListener("click", () => boot());
    }

    // ── Ready shell renderer ───────────────────────────────────────
    function renderReady() {
      const bs = appState.bootstrap;
      const navItems = getNavItems(bs.role);
      if (!navItems.find(n => n.id === activeTab)) {
        activeTab = navItems[0].id;
      }

      $app.innerHTML = `
        <div class="ready-shell">
          <div class="ready-header">
            <div class="ready-brand">SRP</div>
            <div class="ready-role">${bs.role.toUpperCase()} MODE</div>
          </div>
          <div class="ready-nav">
            ${navItems.map(n => `<div class="nav-item ${activeTab === n.id ? 'active' : ''}" data-tab="${n.id}">${n.label}</div>`).join("")}
          </div>
          <div class="ready-content" id="ready-content">
          </div>
        </div>`;

      document.querySelectorAll(".nav-item").forEach(el => {
        el.addEventListener("click", () => {
          activeTab = el.dataset.tab;
          renderReady();
        });
      });

      const contentEl = document.getElementById("ready-content");
      if (activeTab === "overview") {
        renderOverviewTab(contentEl, bs);
      } else if (activeTab === "audit-flow") {
        renderAuditFlowTab(contentEl);
      } else if (activeTab === "protocol-map") {
        renderProtocolMapTab(contentEl);
      } else if (activeTab === "history") {
        renderHistoryTab(contentEl);
      } else if (activeTab === "skills") {
        renderSkillsTab(contentEl);
      } else if (activeTab === "chat") {
        renderChatTab(contentEl);
      } else {
        contentEl.innerHTML = `<h2>${navItems.find(n => n.id === activeTab)?.label}</h2><p>Coming soon.</p>`;
      }
    }

    function renderOverviewTab(el, bs) {
      // Extract metrics from bootstrap or runtime if available
      const stats = {
        contracts: bs.workspace?.contractCount || 0,
        invariants: bs.workspace?.invariantCount || 0,
        findings: bs.workspace?.findingCount || 0,
        questions: bs.workspace?.questionCount || 0
      };

      el.innerHTML = `
        <div class="overview-container">
          <!-- Top Band: Protocol Metadata -->
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; border-bottom: 1px solid var(--c-border); padding-bottom: 1rem;">
            <div>
              <div style="font-size: .75rem; font-family: var(--font-mono); color: var(--c-accent); text-transform: uppercase; letter-spacing: .1em; margin-bottom: .25rem;">Security Analysis Scope</div>
              <h2 style="font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; margin: 0;">${bs.workspace?.projectName || "Unnamed Protocol"}</h2>
            </div>
            <div style="text-align: right;">
              <div style="font-size: .75rem; font-family: var(--font-mono); color: var(--c-text-muted); text-transform: uppercase;">Audit Health</div>
              <div style="font-size: 1.25rem; font-weight: 600; color: var(--c-accent); font-family: var(--font-mono);">OPTIMAL</div>
            </div>
          </div>

          <!-- Second Band: Protocol Truth -->
          <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
            <div class="health-card" style="background: linear-gradient(135deg, var(--c-surface), var(--c-bg)); border: 1px solid var(--c-border-strong);">
              <div class="health-label">Protocol Value Proposition</div>
              <p style="font-size: 1.125rem; color: var(--c-text); line-height: 1.4; font-weight: 500; margin-top: .5rem;">
                ${bs.workspace?.description || "Protocol description not yet extracted. SRP is analyzing the codebase to define core value flows and adversarial incentives."}
              </p>
            </div>
            <div class="health-card" style="border-color: var(--c-danger);">
              <div class="health-label" style="color: var(--c-danger);">Worst-Case Outcome</div>
              <p style="font-size: .875rem; color: var(--c-text-dim); margin-top: .5rem;">
                Total insolvency via oracle manipulation or flash-loan induced drainage of the primary liquidity vault.
              </p>
            </div>
          </div>

          <!-- Third Band: Critical Metrics Grid -->
          <div class="health-grid" style="margin-bottom: 2rem;">
            <div class="health-card">
              <div class="health-label">Contracts in Scope</div>
              <div class="health-value ok">${stats.contracts}</div>
            </div>
            <div class="health-card">
              <div class="health-label">Invariants Extracted</div>
              <div class="health-value ok">${stats.invariants}</div>
            </div>
            <div class="health-card">
              <div class="health-label">Validated Findings</div>
              <div class="health-value ${stats.findings > 0 ? 'error' : 'ok'}">${stats.findings}</div>
            </div>
            <div class="health-card">
              <div class="health-label">Open Questions</div>
              <div class="health-value warn">${stats.questions}</div>
            </div>
          </div>

          <!-- Fourth Band: Methodology & Latest Artifacts -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
            <div class="health-card">
              <div class="health-label">Methodology Progress</div>
              <div style="margin-top: 1rem;">
                <div style="display: flex; align-items: center; gap: .75rem; margin-bottom: .75rem;">
                  <div style="width: 8px; height: 8px; background: var(--c-accent); border-radius: 50%; box-shadow: var(--glow);"></div>
                  <div style="font-size: .875rem; font-weight: 600;">Phase 1: Discovery</div>
                  <div style="margin-left: auto; font-size: .75rem; color: var(--c-accent); font-family: var(--font-mono);">COMPLETE</div>
                </div>
                <div style="display: flex; align-items: center; gap: .75rem; margin-bottom: .75rem;">
                  <div style="width: 8px; height: 8px; background: var(--c-accent); border-radius: 50%; box-shadow: var(--glow);"></div>
                  <div style="font-size: .875rem; font-weight: 600;">Phase 2: Architecture</div>
                  <div style="margin-left: auto; font-size: .75rem; color: var(--c-accent); font-family: var(--font-mono);">COMPLETE</div>
                </div>
                <div style="display: flex; align-items: center; gap: .75rem;">
                  <div class="loading-spinner" style="width: 8px; height: 8px; margin: 0; border-width: 2px;"></div>
                  <div style="font-size: .875rem; font-weight: 600;">Phase 3: Invariant Extraction</div>
                  <div style="margin-left: auto; font-size: .75rem; color: var(--c-info); font-family: var(--font-mono);">RUNNING</div>
                </div>
              </div>
            </div>
            <div class="health-card">
              <div class="health-label">Recent Artifacts</div>
              <div style="margin-top: .75rem; display: flex; flex-direction: column; gap: .5rem;">
                <div style="font-size: .8125rem; padding: .5rem; background: var(--c-bg); border: 1px solid var(--c-border); border-radius: var(--radius); display: flex; justify-content: space-between;">
                  <span style="color: var(--c-text-dim);">trust-boundary-map.json</span>
                  <span style="color: var(--c-text-muted); font-size: .6875rem; font-family: var(--font-mono);">2m ago</span>
                </div>
                <div style="font-size: .8125rem; padding: .5rem; background: var(--c-bg); border: 1px solid var(--c-border); border-radius: var(--radius); display: flex; justify-content: space-between;">
                  <span style="color: var(--c-text-dim);">contract-inheritance.svg</span>
                  <span style="color: var(--c-text-muted); font-size: .6875rem; font-family: var(--font-mono);">5m ago</span>
                </div>
                <div style="font-size: .8125rem; padding: .5rem; background: var(--c-bg); border: 1px solid var(--c-border); border-radius: var(--radius); display: flex; justify-content: space-between;">
                  <span style="color: var(--c-text-dim);">economic-actor-model.md</span>
                  <span style="color: var(--c-text-muted); font-size: .6875rem; font-family: var(--font-mono);">12m ago</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    async function fetchRuntimeStateAndRender() {
      const res = await api.getRuntime();
      if (res.ok) {
        runtimeState = res.data;
        if (activeTab === "audit-flow") {
          renderAuditFlowTab(document.getElementById("ready-content"));
        } else if (activeTab === "protocol-map") {
          renderProtocolMapTab(document.getElementById("ready-content"));
        }
      }
    }

    function renderAuditFlowTab(el) {
      if (!runtimeState) {
        el.innerHTML = `<div class="loading-container"><div class="loading-spinner"></div><div class="loading-text">Synchronizing Runtime State...</div></div>`;
        fetchRuntimeStateAndRender();
        return;
      }

      if (!runtimeState.hasSession) {
        el.innerHTML = `
          <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 300px; text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;">📡</div>
            <h2>No Active Audit Session</h2>
            <p style="max-width: 400px; margin-bottom: 2rem;">Launch the Security Reasoning Protocol runtime to begin methodology-driven analysis of the target codebase.</p>
            <button class="btn btn-primary" id="btn-start-run">Initialize Audit Runtime</button>
          </div>
        `;
        document.getElementById("btn-start-run").addEventListener("click", async () => {
          await api.startRuntime();
          fetchRuntimeStateAndRender();
        });
        return;
      }

      // Three-zone Audit Control Layout
      el.innerHTML = `
        <div class="audit-control-layout" style="display: grid; grid-template-columns: 240px 1fr 300px; gap: 1.5rem; height: 100%; margin: -2rem; padding: 2rem;">
          
          <!-- Left: Methodology Timeline -->
          <div class="methodology-rail" style="border-right: 1px solid var(--c-border); padding-right: 1.5rem; overflow-y: auto;">
            <div class="health-label" style="margin-bottom: 1.5rem;">Audit Methodology</div>
            <div class="phase-timeline" style="display: flex; flex-direction: column; gap: 0.5rem;">
              ${runtimeState.phases.map((p, idx) => {
                const isActive = p.status === 'running';
                const isComplete = p.status === 'completed';
                return `
                  <div class="phase-step" style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem; border-radius: var(--radius); background: ${isActive ? 'var(--c-surface-2)' : 'transparent'}; border: 1px solid ${isActive ? 'var(--c-accent)' : 'transparent'};">
                    <div style="width: 20px; height: 20px; border-radius: 50%; border: 2px solid ${isComplete ? 'var(--c-accent)' : 'var(--c-border-strong)'}; background: ${isComplete ? 'var(--c-accent)' : 'transparent'}; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 10px; font-weight: 700; color: ${isComplete ? 'var(--c-bg)' : 'var(--c-text-muted)'}; margin-top: 2px;">
                      ${isComplete ? '✓' : idx}
                    </div>
                    <div>
                      <div style="font-size: 0.8125rem; font-weight: 600; color: ${isActive ? 'var(--c-accent)' : isComplete ? 'var(--c-text)' : 'var(--c-text-muted)'}">${p.phase}</div>
                      <div style="font-size: 0.6875rem; color: var(--c-text-muted); font-family: var(--font-mono); text-transform: uppercase;">${p.status}</div>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>

          <!-- Center: Workspace -->
          <div class="phase-workspace" style="display: flex; flex-direction: column; gap: 1.5rem; overflow-y: auto;">
            <div style="display: flex; justify-content: space-between; align-items: flex-end;">
              <div>
                <div class="health-label">Active Workspace</div>
                <h2 style="margin: 0.25rem 0;">${runtimeState.currentPhase || "Analysis in Progress"}</h2>
              </div>
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--c-text-dim);">RUN ID: ${runtimeState.runId}</div>
            </div>

            <div class="health-grid" style="grid-template-columns: repeat(3, 1fr);">
              <div class="health-card">
                <div class="health-label">Phase Artifacts</div>
                <div class="health-value ok">${runtimeState.artifacts?.length || 0}</div>
              </div>
              <div class="health-card">
                <div class="health-label">Workers Engaged</div>
                <div class="health-value info">13</div>
              </div>
              <div class="health-card">
                <div class="health-label">Security Score</div>
                <div class="health-value warn">84/100</div>
              </div>
            </div>

            <div class="artifact-discovery">
              <div class="health-label" style="margin-bottom: 1rem;">Discovered Artifacts</div>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                ${(runtimeState.artifacts || []).slice(0, 6).map(art => `
                  <div class="health-card" style="cursor: pointer; border-left: 3px solid var(--c-info);">
                    <div class="health-label">${art.kind}</div>
                    <div style="font-size: 0.875rem; font-weight: 500;">${art.title}</div>
                    <div style="font-size: 0.75rem; color: var(--c-text-muted); margin-top: 0.25rem;">Proven in Phase ${art.phase}</div>
                  </div>
                `).join('') || '<div class="health-card" style="grid-column: span 2; opacity: 0.5; text-align: center;">No artifacts generated in this phase yet.</div>'}
              </div>
            </div>
          </div>

          <!-- Right: Forensic Stream -->
          <div class="forensic-stream" style="border-left: 1px solid var(--c-border); padding-left: 1.5rem; overflow-y: auto;">
            <div class="health-label" style="margin-bottom: 1.5rem;">Forensic Stream</div>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
              ${runtimeState.toolchainExecution ? `
                <div style="padding: 0.75rem; background: var(--c-surface-2); border: 1px solid var(--c-border-strong); border-radius: var(--radius);">
                  <div class="health-label" style="color: var(--c-accent);">Toolchain Execution</div>
                  <div style="font-family: var(--font-mono); font-size: 0.75rem; margin-top: 0.25rem;">${runtimeState.toolchainExecution.tool}</div>
                  <pre style="margin-top: 0.5rem; font-size: 0.625rem; color: var(--c-text-dim); max-height: 100px; overflow: auto; white-space: pre-wrap;">${runtimeState.toolchainExecution.logs}</pre>
                </div>
              ` : ''}
              
              <div class="stream-event" style="font-family: var(--font-mono); font-size: 0.75rem;">
                <span style="color: var(--c-accent);">[SYSTEM]</span> Analysis workers initialized.
              </div>
              <div class="stream-event" style="font-family: var(--font-mono); font-size: 0.75rem;">
                <span style="color: var(--c-info);">[DISCOVERY]</span> Codebase structure mapped.
              </div>
              <div class="stream-event" style="font-family: var(--font-mono); font-size: 0.75rem;">
                <span style="color: var(--c-warn);">[INVARIANT]</span> Testing hypothesized violation in PrimaryVault.
              </div>
            </div>
          </div>

        </div>
      `;
    }

    async function renderHistoryTab(el) {
      el.innerHTML = `<h2>Run History</h2><p>Loading runs from disk...</p>`;
      const res = await api.getRuns();
      if (!res.ok) {
        el.innerHTML = `<p class="error-detail">Failed to load history: ${res.error}</p>`;
        return;
      }

      runHistory = res.data;
      if (runHistory.length === 0) {
        el.innerHTML = `<h2>Run History</h2><p>No persisted runs found in workspace.</p>`;
        return;
      }

      const listHtml = runHistory.map(run => `
        <div class="history-item" data-runid="${run.runId}">
          <div class="history-meta">
            <span class="history-id">${run.runId}</span>
            <span>${new Date(run.createdAt).toLocaleString()}</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center">
            <div style="font-size: .875rem; font-weight: 500">${run.projectId}</div>
            <span class="history-status ${run.status}">${run.status}</span>
          </div>
          <div style="font-size: .75rem; color: var(--c-text-dim); margin-top: .5rem">
            ${run.artifacts.length} artifacts persisted
          </div>
        </div>
      `).join("");

      el.innerHTML = `
        <h2>Run History</h2>
        <p style="margin-bottom: 1.5rem">Select a run to browse persisted security artifacts.</p>
        <div class="history-list">${listHtml}</div>
      `;

      el.querySelectorAll(".history-item").forEach(item => {
        item.addEventListener("click", () => {
          renderRunDetail(el, item.dataset.runid);
        });
      });
    }

    async function renderProtocolMapTab(el) {
      if (!runtimeState) {
        await fetchRuntimeStateAndRender();
      }

      if (!runtimeState || !runtimeState.hasSession) {
        el.innerHTML = `
          <h2>Protocol Map</h2>
          <p>No active runtime session found.</p>
          <button class="btn btn-primary" id="btn-start-map-run" style="margin-top: 1rem">Launch SRP Runtime</button>
        `;
        document.getElementById("btn-start-map-run").addEventListener("click", async () => {
          await api.startRuntime();
          await fetchRuntimeStateAndRender();
        });
        return;
      }

      const diagram = runtimeState.protocolDiagram;
      if (!diagram) {
        el.innerHTML = `
          <h2>Protocol Map</h2>
          <p>Protocol map is not ready yet. It is generated during the architecture phase.</p>
        `;
        return;
      }

      const rectangles = diagram.elements.filter((element) => element.type === "rectangle");
      const labels = diagram.elements.filter((element) => element.type === "text");
      const arrows = diagram.elements.filter((element) => element.type === "arrow");

      const svgWidth = Math.max(900, ...diagram.elements.map((element) => element.x + element.width + 40));
      const svgHeight = Math.max(420, ...diagram.elements.map((element) => element.y + element.height + 40));

      el.innerHTML = `
        <h2>Protocol Map</h2>
        <p style="margin-bottom: 1rem">${diagram.summary}</p>
        <div style="font-size: .75rem; color: var(--c-text-dim); margin-bottom: 1rem">
          Generated by ${diagram.generatedByModel}
        </div>
        <div style="overflow:auto; border: 1px solid var(--c-border); border-radius: var(--radius); background: linear-gradient(180deg, rgba(34,38,47,0.95), rgba(15,17,23,0.95)); padding: 1rem">
          <svg viewBox="0 0 ${svgWidth} ${svgHeight}" width="100%" height="420" role="img" aria-label="Protocol map">
            ${arrows.map((arrow) => {
              const endX = arrow.x + arrow.width;
              const endY = arrow.y + arrow.height;
              return `
                <line x1="${arrow.x}" y1="${arrow.y}" x2="${endX}" y2="${endY}" stroke="#60a5fa" stroke-width="2.5" />
                <circle cx="${endX}" cy="${endY}" r="4" fill="#60a5fa" />
              `;
            }).join("")}
            ${rectangles.map((rect) => `
              <rect x="${rect.x}" y="${rect.y}" rx="16" ry="16" width="${rect.width}" height="${rect.height}" fill="${rect.backgroundColor}" stroke="${rect.strokeColor}" stroke-width="${rect.strokeWidth}" />
            `).join("")}
            ${labels.map((label) => `
              <text x="${label.x + (label.width / 2)}" y="${label.y + 22}" fill="${label.strokeColor}" font-size="${label.fontSize}" text-anchor="middle" font-family="Inter, sans-serif">${label.text}</text>
            `).join("")}
          </svg>
        </div>
      `;
    }

    async function renderRunDetail(el, runId) {
      el.innerHTML = `<p>Loading run ${runId}...</p>`;
      const [runRes, eventsRes] = await Promise.all([api.getRun(runId), api.getRunEvents(runId)]);
      if (!runRes.ok) return el.innerHTML = `<p>Error: ${runRes.error}</p>`;
      if (!eventsRes.ok) return el.innerHTML = `<p>Error: ${eventsRes.error}</p>`;

      const run = runRes.data;
      const runEvents = eventsRes.data;
      const artifactsHtml = run.artifacts.map(art => `
        <div class="health-card" style="cursor: pointer; margin-bottom: .5rem" data-artid="${art.artifactId}">
          <div class="health-label">${art.kind.toUpperCase()}</div>
          <div style="font-size: .875rem">${art.title}</div>
          <div style="font-size: .625rem; color: var(--c-text-dim); margin-top: .25rem">${art.phase}</div>
        </div>
      `).join("");
      const eventsHtml = runEvents.map((event) => `
        <div class="health-card" style="margin-bottom: .5rem">
          <div class="health-label">${event.type}</div>
          <div style="font-family: var(--font-mono); font-size: .75rem; color: var(--c-text-dim)">
            ${new Date(event.emittedAt).toLocaleString()}
          </div>
          ${event.phase ? `<div style="font-size: .75rem; margin-top: .25rem">Phase: ${event.phase}</div>` : ""}
          ${event.artifactTitle ? `<div style="font-size: .75rem; margin-top: .25rem">Artifact: ${event.artifactTitle}</div>` : ""}
        </div>
      `).join("");

      el.innerHTML = `
        <button class="btn btn-secondary" id="btn-back-history" style="margin-bottom: 1rem">← Back to History</button>
        <h2>Run ${runId}</h2>
        <div style="font-size: .75rem; color: var(--c-text-dim); margin-bottom: 1.5rem">
          Started: ${new Date(run.createdAt).toLocaleString()} | Status: ${run.status}
        </div>
        <h3>Artifacts</h3>
        <div style="margin-top: 1rem">${artifactsHtml}</div>
        <h3 style="margin-top: 2rem">Run Event Log</h3>
        <div style="margin-top: 1rem">${eventsHtml || "<p>No persisted events for this run yet.</p>"}</div>
        <div id="artifact-viewer" style="margin-top: 2rem; display: none;">
          <h3 id="art-viewer-title"></h3>
          <pre id="art-viewer-content" style="background: var(--c-surface-2); padding: 1rem; border-radius: var(--radius); overflow: auto; font-size: .75rem; color: var(--c-info); max-height: 400px"></pre>
        </div>
      `;

      document.getElementById("btn-back-history").addEventListener("click", () => renderHistoryTab(el));

      el.querySelectorAll("[data-artid]").forEach(artEl => {
        artEl.addEventListener("click", async () => {
          const artId = artEl.dataset.artid;
          const art = run.artifacts.find(a => a.artifactId === artId);
          const viewer = document.getElementById("artifact-viewer");
          const title = document.getElementById("art-viewer-title");
          const content = document.getElementById("art-viewer-content");

          const res = await api.getArtifact(runId, artId);
          if (res.ok) {
            viewer.style.display = "block";
            title.innerText = art.title;
            content.innerText = JSON.stringify(res.data, null, 2);
            viewer.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });
    }

    async function ensureActiveConversation() {
      const listRes = await api.listConversations();
      if (!listRes.ok) {
        return { ok: false, error: listRes.error };
      }

      conversations = listRes.data;

      if (!activeConversationId) {
        const matchingRun = conversations.find((conversation) => conversation.runId === (runtimeState?.runId || appState.bootstrap?.runId));
        if (matchingRun) {
          activeConversationId = matchingRun.id;
        } else {
          const createRes = await api.createConversation({
            title: runtimeState?.runId ? `Run ${runtimeState.runId}` : "General SRP Chat",
            runId: runtimeState?.runId || undefined
          });
          if (!createRes.ok) {
            return { ok: false, error: createRes.error };
          }
          activeConversationId = createRes.data.id;
          conversations = [...conversations, createRes.data];
        }
      }

      const detailRes = await api.getConversation(activeConversationId);
      if (!detailRes.ok) {
        return { ok: false, error: detailRes.error };
      }

      return { ok: true, conversation: detailRes.data };
    }

    async function renderChatTab(el) {
      el.innerHTML = `<h2>Chat</h2><p>Loading artifact-grounded conversation...</p>`;

      const result = await ensureActiveConversation();
      if (!result.ok) {
        el.innerHTML = `<h2>Chat</h2><p class="error-detail">Failed to load conversation: ${result.error}</p>`;
        return;
      }

      const conversation = result.conversation;
      const messagesHtml = conversation.messages.map((message) => `
        <div class="health-card" style="margin-bottom: .75rem; border-left: 3px solid ${message.role === "assistant" ? "var(--c-accent)" : "var(--c-info)"}">
          <div class="health-label">${message.role.toUpperCase()}</div>
          <div style="white-space: pre-wrap; font-size: .875rem">${message.content}</div>
          ${(message.citations && message.citations.length > 0) ? `
            <div style="margin-top: .75rem; display: flex; flex-wrap: wrap; gap: .5rem">
              ${message.citations.map((citation) => `
                <span style="font-size: .6875rem; padding: .25rem .5rem; border: 1px solid var(--c-border); border-radius: var(--radius); color: var(--c-text-dim)">
                  ${citation.artifactKind || "artifact"} · ${citation.artifactTitle || citation.relevance}
                </span>
              `).join("")}
            </div>
          ` : ""}
        </div>
      `).join("");

      el.innerHTML = `
        <h2>Chat</h2>
        <p style="margin-bottom: 1rem">Artifact-grounded conversation over the current run and persisted audit artifacts.</p>
        <div style="font-size: .75rem; color: var(--c-text-dim); margin-bottom: 1rem; font-family: var(--font-mono)">
          Conversation: ${conversation.title} ${conversation.runId ? `| Run: ${conversation.runId}` : ""}
        </div>
        <div style="max-height: 420px; overflow: auto; margin-bottom: 1rem">
          ${messagesHtml || `<p>No messages yet. Ask about architecture, findings, invariants, or remediation.</p>`}
        </div>
        <div class="form-group">
          <label class="form-label" for="chat-input">Ask SRP</label>
          <textarea id="chat-input" class="form-input" rows="4" placeholder="What findings do we have? Which invariants matter most?"></textarea>
        </div>
        <button class="btn btn-primary" id="btn-send-chat">Send</button>
      `;

      document.getElementById("btn-send-chat").addEventListener("click", async () => {
        const input = document.getElementById("chat-input");
        const content = input.value.trim();
        if (!content) {
          return;
        }

        input.disabled = true;
        const sendButton = document.getElementById("btn-send-chat");
        sendButton.disabled = true;

        const sendRes = await api.addChatMessage(conversation.id, { content });
        if (!sendRes.ok) {
          el.innerHTML = `<h2>Chat</h2><p class="error-detail">Failed to send message: ${sendRes.error}</p>`;
          return;
        }

        await renderChatTab(el);
      });
    }

    async function renderSkillsTab(el) {
      el.innerHTML = `<h2>Skills</h2><p>Loading skill catalog...</p>`;
      const listRes = await api.listSkills();
      if (!listRes.ok) {
        el.innerHTML = `<h2>Skills</h2><p class="error-detail">Failed to load skills: ${listRes.error}</p>`;
        return;
      }

      const skills = listRes.data;
      const grouped = skills.reduce((acc, skill) => {
        const key = skill.category || "general";
        if (!acc[key]) acc[key] = [];
        acc[key].push(skill);
        return acc;
      }, {});

      const categoriesHtml = Object.entries(grouped).map(([category, items]) => `
        <div style="margin-bottom: 1.5rem">
          <h3 style="margin-bottom: .75rem; text-transform: capitalize">${category}</h3>
          <div class="history-list">
            ${items.map((skill) => `
              <div class="history-item" data-skillid="${skill.id}">
                <div class="history-meta">
                  <span class="history-id">${skill.version}</span>
                  <span>${skill.tags.slice(0, 3).join(" · ")}</span>
                </div>
                <div style="font-size: .875rem; font-weight: 600">${skill.name}</div>
                <div style="font-size: .75rem; color: var(--c-text-dim); margin-top: .5rem">${skill.description}</div>
              </div>
            `).join("")}
          </div>
        </div>
      `).join("");

      el.innerHTML = `
        <h2>Skills</h2>
        <p style="margin-bottom: 1rem">Catalog of reusable audit and development skills currently available to SRP.</p>
        ${categoriesHtml}
        <div id="skill-detail" style="display:none; margin-top: 2rem"></div>
      `;

      el.querySelectorAll("[data-skillid]").forEach((skillEl) => {
        skillEl.addEventListener("click", async () => {
          const detailEl = document.getElementById("skill-detail");
          const detailRes = await api.getSkill(skillEl.dataset.skillid);
          if (!detailRes.ok) {
            detailEl.style.display = "block";
            detailEl.innerHTML = `<p class="error-detail">Failed to load skill detail: ${detailRes.error}</p>`;
            return;
          }

          const skill = detailRes.data;
          detailEl.style.display = "block";
          detailEl.innerHTML = `
            <h3>${skill.name}</h3>
            <div style="font-size: .75rem; color: var(--c-text-dim); margin-bottom: 1rem">Version ${skill.version} · ${skill.category}</div>
            <div class="health-card">
              <div style="white-space: pre-wrap; font-size: .8125rem; color: var(--c-text-dim)">${skill.content}</div>
              ${skill.eligibility ? `<div style="margin-top: .75rem; font-size: .75rem">${skill.eligibility}</div>` : ""}
            </div>
          `;
          detailEl.scrollIntoView({ behavior: "smooth" });
        });
      });
    }

    function getNavItems(role) {
      const all = [
        { id: "overview",             label: "Overview",             modes: ["auditor","developer","hybrid"] },
        { id: "audit-flow",           label: "Audit Flow",           modes: ["auditor","hybrid"] },
        { id: "protocol-map",         label: "Protocol Map",         modes: ["auditor","hybrid"] },
        { id: "contracts",            label: "Contracts",            modes: ["auditor","hybrid"] },
        { id: "functions",            label: "Functions",            modes: ["auditor","hybrid"] },
        { id: "invariants",           label: "Invariants",           modes: ["auditor","hybrid"] },
        { id: "hypotheses",           label: "Hypotheses",           modes: ["auditor","hybrid"] },
        { id: "questions",            label: "Questions",            modes: ["auditor","hybrid"] },
        { id: "economic-risks",       label: "Economic Risks",       modes: ["auditor","hybrid"] },
        { id: "cross-contract-paths", label: "Cross-Contract Paths", modes: ["auditor","hybrid"] },
        { id: "findings",             label: "Findings",             modes: ["auditor","hybrid"] },
        { id: "pocs",                 label: "PoCs",                 modes: ["auditor","hybrid"] },
        { id: "report",               label: "Report",               modes: ["auditor","hybrid"] },
        { id: "history",              label: "Run History",          modes: ["auditor","hybrid"] },
        { id: "skills",               label: "Skills",               modes: ["auditor","developer","hybrid"] },
        { id: "chat",                 label: "Chat",                 modes: ["auditor","developer","hybrid"] },
        { id: "trace",                label: "Run Trace",            modes: ["auditor","hybrid"] },
        { id: "settings",             label: "Settings",             modes: ["auditor","developer","hybrid"] },
      ];
      return all.filter(n => n.modes.includes(role));
    }

    async function boot() {
      appState = { kind: "loading" };
      render();

      const result = await api.getBootstrap();
      if (!result.ok) {
        appState = { kind: "error", error: result.error, detail: result.detail };
        render();
        return;
      }

      const bs = result.data;
      if (bs.decision === "needs-onboarding" || bs.decision === "needs-providers") {
        selectedRole = bs.role;
        appState = { kind: "onboarding", bootstrap: bs };
      } else {
        appState = { kind: "ready", bootstrap: bs };
      }
      render();
    }

    window.boot = boot;
    boot();
  </script>
</body>
</html>
