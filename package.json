{
  "name": "security-reasoning-protocol",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Security Reasoning Protocol, an AI-native Web3 security operating system for EVM and Solana teams.",
  "scripts": {
    "dev": "node apps/api/src/server.ts",
    "start": "node apps/api/src/server.ts",
    "test": "node --test packages/core/test/*.test.ts apps/api/test/*.test.ts apps/cli/test/*.test.ts apps/mcp/test/*.test.ts",
    "smoke": "node apps/api/src/smoke.ts",
    "scan": "node apps/cli/src/cli.ts scan",
    "mcp": "node apps/cli/src/cli.ts mcp",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test:pack": "node scripts/pack-test.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "srp": "dist/apps/cli/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ]
}
