        vm.expectRevert(
            abi.encodeWithSelector(
                ISatelliteEmissionsController.SatelliteEmissionsController_InvalidWithdrawAmount.selector
            )
        );
        protocol.satelliteEmissionsController.withdrawUnclaimedEmissions(4, users.bob);
