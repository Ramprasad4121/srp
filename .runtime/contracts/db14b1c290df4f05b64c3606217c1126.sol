        uint256 newGasCost = 70_000;

        for (uint256 i = 0; i < testUsers.length; i++) {
            vm.expectRevert(
                abi.encodeWithSelector(
                    IAccessControl.AccessControlUnauthorizedAccount.selector, testUsers[i], DEFAULT_ADMIN_ROLE
                )
